{
  "name": "payflex-api",
  "version": "1.0.0",
  "description": "PayFlex API - target application for the advanced CI/CD lab",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "jest --ci --coverage"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": ["src/**/*.js", "!src/server.js"],
    "coverageReporters": ["text", "lcov", "json-summary"]
  }
}
